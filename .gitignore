/target/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/coverage/
/fuzz/target/
/fuzz/Cargo.lock
/.ci-home/
/.cargo-home/
/.cargo-audit-db/
/.cargo-audit-db
/.cargo-audit-db..lock
/.cargo-audit-db*

# Transient advisory lock for the shared live-lab ledger appends (serializes
# concurrent disjoint-node lab runs). On unix these lock files are deliberately
# PERSISTENT — never unlinked on release, see crates/rustynet-cli/src/append_lock.rs
# on the split-inode race — so they MUST be ignored or every run after the first
# leaves the worktree dirty and trips the setup->run git-provenance check.
/documents/operations/live_lab_run_matrix.csv.lock
/documents/operations/live_lab_node_run_matrix.csv.lock
/documents/operations/live_lab_node_stage_results.csv.lock
/documents/operations/live_lab_stage_triage.jsonl.lock

# Scratch files for the tmp+rename ledger replaces. Present only mid-write, or
# left behind by a crashed/failed rename; never content anything reads.
/documents/operations/live_lab_run_matrix.csv.tmp
/documents/operations/live_lab_node_run_matrix.csv.tmp
/documents/operations/live_lab_node_stage_results.csv.tmp
/documents/operations/live_lab_stage_triage.jsonl.tmp

# MCP server build output (binaries built by scripts/mcp/install.sh into ./bin).
# Build from source; do not commit the compiled servers.
/bin/

# Isolated cargo target dir for MCP-launched live-lab jobs (build isolation so
# lab runs never contend with the gate-runner on the workspace target lock).
/target-livelab/
/target-deepseek-*/

# CARGO_TARGET_DIR for local gate runs (CLAUDE.md/AGENTS.md §7). Missing here
# left it untracked at the repo root, which trips the same setup->run
# git-provenance check the .lock/.tmp entries above exist to avoid — every
# live-lab launch this session failed "worktree must be clean" against this
# one directory, not against real dirt.
/target-gate/

# Editor-local config (absolute machine paths; wire up via scripts/mcp/install.sh).
/.zed/

# Local desktop noise
.DS_Store
__pycache__/

# Generated artifacts are local-only by default.
# Existing tracked artifact files remain tracked until explicitly removed from the index.
/artifacts/**
!/artifacts/**/.gitkeep
# Live-lab report directories written by `ops vm-lab-setup-live-lab` and
# `ops vm-lab-run-live-lab` land here (state/live-lab-<UTC>/). They are
# local-only evidence — the run wrapper refuses to generate the
# commit-bound fresh-install OS matrix report from a dirty tree, so
# leaving these dirs untracked would otherwise hard-fail every live lab
# run with `cannot generate commit-bound … report from a dirty working
# tree`.
/state/**
/profiles/live_lab/*.env
/profiles/live_lab/generated_vm_lab_*_known_hosts
!/profiles/live_lab/default_four_node.env
!/profiles/live_lab/default_five_node.env
/third_party/boringtun/.cargo-ok
/third_party/boringtun/.cargo_vcs_info.json
/third_party/boringtun/Cargo.toml.orig
.aider*

# Transient agent worktrees (harness-managed, never commit)
.claude/worktrees/

# Lab SSH bootstrap passwords. The inventory beside this is public; these are not.
*.secrets.json
